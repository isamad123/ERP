                  "additionalProperties": false,
                  "title": "hrm.policy.param.leave.eligibility",
                  "properties": {
                    "genders": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "enum": ["male", "female", "other", "unspecified"] }, "title": "hrm.policy.param.leave.genders" },
                    "minServiceMonths": { "type": "integer", "minimum": 0, "maximum": 600, "title": "hrm.policy.param.leave.min_service_months" },
