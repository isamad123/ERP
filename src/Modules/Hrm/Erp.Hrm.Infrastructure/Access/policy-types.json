                    "expiryMonths": { "type": "integer", "minimum": 1, "maximum": 120, "title": "hrm.policy.param.leave.carry_forward_expiry_months" }
                  }
                },
                "encashment": {
                  "type": "object",
                  "additionalProperties": false,
                  "title": "hrm.policy.param.leave.encashment",
                  "properties": {
                    "cap": { "type": "number", "minimum": 0, "maximum": 9999, "title": "hrm.policy.param.leave.encashment_cap" },
                    "rateBasis": { "type": "string", "minLength": 1, "maxLength": 40, "title": "hrm.policy.param.leave.encashment_rate_basis" }
