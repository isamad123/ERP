        {"name": "employee", "type": "user", "label": {"en": "Employee", "ur": "ملازم"}},
        {"name": "employee_no", "type": "text", "label": {"en": "Employee number", "ur": "ملازم نمبر"}},
        {"name": "unit", "type": "org_unit", "label": {"en": "Unit", "ur": "یونٹ"}},
        {"name": "position", "type": "text", "label": {"en": "Position code", "ur": "عہدے کا کوڈ"}}
      ],
      "company_field": "company",
      "subject_fields": ["employee"],
      "title": {"en": "Strength exception for {employee_no} from {effective_date}", "ur": "{employee_no} کے لیے افرادی قوت کا استثنا، {effective_date} سے"},
      "link": "/hrm/strength-exceptions/{document_id}",
      "bulk_approval": false,
