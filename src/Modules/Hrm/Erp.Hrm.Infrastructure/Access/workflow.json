{
  "_comment": "Document types the HR module sends for approval (slice S1.10 format). S1.20b (CR-076 item 8, slice S1.20 ruling Q11): an employment event of a kind the company setting hrm.employment_events.approval_kinds lists waits for this route and applies on approval; the requester and the employee never approve it (FR-XM-32). Changing the route needs a second administrator (requires_approval). S1.20c: a transfer between companies uses kind transfer and gives to_company (review S1.20c finding 9). Seeded by migrate and provisioning with its default route, active at once. S1.22a (CR-078 item 2, slice S1.22 ruling Q5): hrm.strength_exception is the permission to place one person beyond a position's budgeted FTE or a unit and grade's sanctioned count; default route HR Admin; the person placed and the requester never approve it (FR-XM-32). Urdu texts to be reviewed by a native speaker (R-062).",
  "module": "hrm",
  "document_types": [
    {
      "code": "hrm.employment_event",
      "entitlement_key": "hrm.core",
      "name": {"en": "Employment change", "ur": "ملازمت میں تبدیلی"},
      "fields": [
        {"name": "company", "type": "company", "label": {"en": "Company", "ur": "کمپنی"}},
        {"name": "kind", "type": "choice", "choices": ["promotion", "demotion", "transfer", "grade_change", "acting", "secondment", "confirmation", "data_correction"], "label": {"en": "Kind of change", "ur": "تبدیلی کی قسم"}},
        {"name": "effective_date", "type": "date", "label": {"en": "Effective date", "ur": "مؤثر تاریخ"}},
        {"name": "employee", "type": "user", "label": {"en": "Employee", "ur": "ملازم"}},
        {"name": "employee_no", "type": "text", "label": {"en": "Employee number", "ur": "ملازم نمبر"}},
        {"name": "unit", "type": "org_unit", "label": {"en": "Unit after the change", "ur": "تبدیلی کے بعد یونٹ"}},
        {"name": "to_company", "type": "company", "label": {"en": "Receiving company (transfer between companies)", "ur": "وصول کرنے والی کمپنی (کمپنیوں کے درمیان تبادلہ)"}}
      ],
      "company_field": "company",
      "subject_fields": ["employee"],
      "title": {"en": "Employment change ({kind}) of {employee_no} from {effective_date}", "ur": "ملازمت میں تبدیلی ({kind})، {employee_no}، {effective_date} سے"},
      "link": "/hrm/employment-events/{document_id}",
      "bulk_approval": false,
