<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../Erp.Kernel.Domain/Erp.Kernel.Domain.csproj" />
    <ProjectReference Include="../Erp.Kernel.Application/Erp.Kernel.Application.csproj" />
    <ProjectReference Include="../../BuildingBlocks/Erp.BuildingBlocks.Infrastructure/Erp.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Sylvan.Data.Csv" />
    <PackageReference Include="Sylvan.Data.Excel" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="PuppeteerSharp" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <!-- Slice S1.11c2: Noto Sans and Noto Nastaliq Urdu (SIL Open Font Licence 1.1, fonts only, ruling Q18) travel with the product. -->
    <EmbeddedResource Include="Documents/Templates/Fonts/*.ttf" LogicalName="Erp.Kernel.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Slice S1.06: the unit tests check the engine's merge and scope rules directly. -->
    <InternalsVisibleTo Include="Erp.UnitTests" />
    <!-- R-028: the role-race test calls ClusterAdministrator.EnsureNoLoginRolesAsync with roles of its own. -->
    <InternalsVisibleTo Include="Erp.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ControlPlane/Provisioning/baseline-seed.json" LogicalName="Erp.Kernel.Infrastructure.ControlPlane.Provisioning.baseline-seed.json" />
    <EmbeddedResource Include="Settings/country-defaults.json" LogicalName="Erp.Kernel.Infrastructure.Settings.country-defaults.json" />
    <EmbeddedResource Include="Access/settings.g.json" LogicalName="Erp.Kernel.Infrastructure.Access.settings.g.json" />
    <EmbeddedResource Include="Access/imports.json" LogicalName="Erp.Kernel.Infrastructure.Access.imports.json" />
    <EmbeddedResource Include="Access/jobs.json" LogicalName="Erp.Kernel.Infrastructure.Access.jobs.json" />
    <EmbeddedResource Include="Access/setup-tasks.json" LogicalName="Erp.Kernel.Infrastructure.Access.setup-tasks.json" />
    <EmbeddedResource Include="Access/notification-events.json" LogicalName="Erp.Kernel.Infrastructure.Access.notification-events.json" />
    <!-- Slice S1.11b2: the fixed words of notification e-mails (button, footer) come from the notification texts. -->
    <EmbeddedResource Include="../Erp.Kernel.Contracts/Itg/Localization/import.en.json" LogicalName="Erp.Kernel.Import.en.json" WithCulture="false" />
    <EmbeddedResource Include="../Erp.Kernel.Contracts/Itg/Localization/import.ur.json" LogicalName="Erp.Kernel.Import.ur.json" WithCulture="false" />
    <EmbeddedResource Include="../Erp.Kernel.Contracts/Notifications/Localization/notifications.en.json" LogicalName="Erp.Kernel.Notifications.en.json" WithCulture="false" />
    <EmbeddedResource Include="../Erp.Kernel.Contracts/Notifications/Localization/notifications.ur.json" LogicalName="Erp.Kernel.Notifications.ur.json" WithCulture="false" />
    <EmbeddedResource Include="Entitlements/entitlement-keys.json" LogicalName="Erp.Kernel.Infrastructure.Entitlements.entitlement-keys.json" />
  </ItemGroup>
</Project>
