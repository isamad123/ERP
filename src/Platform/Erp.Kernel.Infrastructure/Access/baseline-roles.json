  "data_scopes": [
    {
      "code": "all",
      "kind": "all",
      "name": {
        "en": "All records",
        "ur": "تمام ریکارڈ"
      }
    },
    {
      "code": "own",
      "kind": "own",
      "name": {
        "en": "Own records",
        "ur": "اپنے ریکارڈ"
      }
    },
