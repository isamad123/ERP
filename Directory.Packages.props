<Project>
  <!-- Central package versions. Every package must be in docs/registers/dependencies.md (D-09). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageVersion Include="Sylvan.Data.Excel" Version="0.5.8" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <PackageVersion Include="NSec.Cryptography" Version="26.4.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.0.1" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="AWSSDK.S3" Version="4.1.0" />
    <PackageVersion Include="Scriban" Version="7.6.1" />
    <PackageVersion Include="PuppeteerSharp" Version="25.18.1" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
</Project>
